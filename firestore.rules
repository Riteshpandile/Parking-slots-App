rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /parkingSlots/{slotId} {
      allow read, write: if true;
    }
    match /parkingTransactions/{txId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
